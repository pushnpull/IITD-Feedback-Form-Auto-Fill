{
  "manifest_version": 3,
  "name": "IITD Feedback Auto Fill",
  "description": "Auto-fills IITD faculty feedback form (2025)",
  "version": "1.1",

  "action": {
    "default_icon": "iitd.png",
    "default_title": "Fill Feedback"
  },

  "background": {
    "service_worker": "background.js"
  },

  "icons": {
    "128": "iitd.png"
  },

  "permissions": [
    "scripting"
  ],

  "host_permissions": [
    "https://eacademics.iitd.ac.in/*"
  ]
}
